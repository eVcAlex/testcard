{
  "name": "testcard",
  "private": true,
  "version": "0.1.0",
  "description": "A dark, watermark-free IPTV player for Windows.",
  "author": "Alex McGuiness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eVcAlex/testcard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @testcard/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "typecheck": "pnpm -r typecheck",
    "package": "pnpm --filter @testcard/desktop package",
    "icons": "node scripts/brand/make-icons.mjs",
    "release:android": "node scripts/release-android.mjs",
    "android:emulator": "node scripts/android-dev.mjs emulator",
    "android:run": "node scripts/android-dev.mjs run",
    "android:log": "node scripts/android-dev.mjs log",
    "android:install": "node scripts/android-dev.mjs install"
  },
  "devDependencies": {
    "oxlint": "^1.24.0",
    "sharp": "0.33.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
