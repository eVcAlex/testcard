+package expo.modules.video.records
+
+import android.graphics.Color
+import androidx.media3.ui.CaptionStyleCompat
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+
+/**
+ * How the app wants captions drawn, in place of the device's accessibility caption settings.
+ * Colours are ARGB ints; `edgeType` is one of CaptionStyleCompat's EDGE_TYPE_* values.
+ */
+data class CaptionStyleOptions(
+  @Field val textScale: Float = 1f,
+  @Field val foregroundColor: Int = Color.WHITE,
+  @Field val backgroundColor: Int = Color.TRANSPARENT,
+  @Field val windowColor: Int = Color.TRANSPARENT,
+  @Field val edgeType: Int = CaptionStyleCompat.EDGE_TYPE_DROP_SHADOW,
+  @Field val edgeColor: Int = Color.BLACK
+) : Record
