# deps / build
node_modules/
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# mpv runtime, fetched by scripts/fetch-mpv.* — never committed
apps/desktop/resources/mpv/

# secrets — credentials belong in the OS keychain, never on disk in this repo
*.env
*.env.*
!.env.example

# local wrangler state — holds the local D1 database, i.e. real account rows and encrypted
# credential blobs once the desktop app syncs against it. Never committed.
apps/sync-worker/.wrangler/

# playlists / provider data — never commit real playlists
*.m3u
*.m3u8
**/fixtures/*.local.*

# editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# logs
*.log
pnpm-debug.log*

# local worktrees / agent scratch workspace — never committed
.worktrees/
.superpowers/

# local worker secrets
.dev.vars

# dev-time TypeSafe/Jev audit cache (category names + Jev's answers; regenerable)
packages/core/evals/.cache/
.android-device
