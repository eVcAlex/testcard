/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
# Cloudflare joins Cache-Control values from every matching rule, so nothing broad is set above: HTML is listed route by route.
/
  Cache-Control: no-cache
/features
  Cache-Control: no-cache
/download
  Cache-Control: no-cache
/setup
  Cache-Control: no-cache
/faq
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/terms
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The font file is versioned by name (PlusJakartaSans-latin.v1.woff2): bump the name when it is re-subset.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/theme-init.js
  Cache-Control: public, max-age=3600
/og.png
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=3600
/shots/*
  Cache-Control: public, max-age=3600
/link
  Cache-Control: no-store
/link/
  Cache-Control: no-store
